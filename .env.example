# Vibe Design Starter Kit — 환경 변수 템플릿
# 실제 값은 .env.local 에 기입 (gitignore 대상)

# Supabase 클라이언트 연결 (브라우저 노출 OK, RLS 가 보호)
# Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Anthropic API Key 는 클라이언트에 두지 않습니다.
# Supabase Edge Function (anthropic-proxy) 의 secret 에만 보관:
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-api03-...
# 클라이언트는 supabase.functions.invoke('anthropic-proxy') 로 호출.
